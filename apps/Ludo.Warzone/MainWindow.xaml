<Window x:Class="Ludo.Warzone.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Ludo.Warzone"
 Title="Ludo · Warzone" Width="1320" Height="980" MinWidth="1080" MinHeight="750" Background="#173563" Foreground="#E9EEF7" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Background" Value="#D9E7FA"/><Setter Property="Foreground" Value="#121D2D"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="#80CFFF" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,5,0,12"/><Setter Property="Padding" Value="7"/><Setter Property="Foreground" Value="#10151E"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,5"/><Setter Property="Foreground" Value="#E9EEF7"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="22,12"/><Setter Property="Foreground" Value="#D3EFFF"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabChrome" Background="#214B7E" CornerRadius="12,12,0,0" Padding="{TemplateBinding Padding}" BorderBrush="#FFC94D" BorderThickness="0"><ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#326BA9"/><Setter TargetName="TabChrome" Property="BorderThickness" Value="0,0,0,3"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <DockPanel Margin="24">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,20"><StackPanel><TextBlock Text="LUDO / WARZONE" FontSize="26" FontWeight="Bold"/><TextBlock Text="Play. Train. Become a stronger opponent." Foreground="#9CACBF" Margin="0,5,0,0"/></StackPanel><TextBlock Text="LOCAL LABORATORY" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#80B8FF" FontSize="12"/></Grid>
  <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#B4C8DF" Text="Ready."/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

   <TabControl x:Name="Tabs" Grid.Column="0" Background="#173563" BorderThickness="0">
    <TabItem Header="Spectate"><Grid Margin="0,18,0,0">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
     <Grid Margin="0,0,18,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="TurnText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#E9EEF7"/><local:BoardView x:Name="Board" Grid.Row="1" MaxWidth="660" HorizontalAlignment="Center"/></Grid>
     <Border Grid.Column="1" Background="#102B54" CornerRadius="12" Padding="14"><DockPanel>
      <StackPanel DockPanel.Dock="Top"><TextBlock Text="DECISION INSPECTOR" Foreground="#A8C1DE" FontWeight="Bold"/><TextBlock x:Name="ChoiceText" Foreground="#E9EEF7" TextWrapping="Wrap" Margin="0,12,0,16"/><TextBlock Text="MOVE LOG" Foreground="#A8C1DE" FontWeight="Bold" Margin="0,0,0,10"/></StackPanel>
      <ListBox x:Name="MoveLog" Background="Transparent" Foreground="#CDD9E9" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" FontSize="13"/></DataTemplate></ListBox.ItemTemplate></ListBox>
     </DockPanel></Border>
     <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0"><WrapPanel><Button x:Name="PlayButton" Background="#FFD36B" Content="Play" Click="PlayClick"/><Button Content="Step turn" Click="StepClick"/><Button Content="Instant result" Click="InstantClick"/><Button Content="Save replay…" Click="SaveReplayClick"/></WrapPanel><DockPanel><TextBlock Text="Speed  0.5×" Foreground="#CDD9E9"/><TextBlock Text="50×" DockPanel.Dock="Right" Foreground="#CDD9E9"/><Slider x:Name="SpeedSlider" Minimum="0.5" Maximum="50" Value="1" TickFrequency="0.5" Margin="12,0"/></DockPanel></StackPanel>
    </Grid></TabItem>
    <TabItem Header="Tournaments"><Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Run a fair comparison" FontSize="23" Foreground="#E9EEF7" FontWeight="SemiBold"/><TextBlock Text="Mirrored seeds · balanced seats · isolated C# bots" Foreground="#9CACBF" Margin="0,6,0,16"/>
      <WrapPanel><StackPanel Width="130" Margin="0,0,16,0"><TextBlock Text="Games" Foreground="#E9EEF7"/><TextBox x:Name="GamesBox" Text="10000"/></StackPanel><StackPanel Width="130" Margin="0,0,16,0"><TextBlock Text="Parallel workers" Foreground="#E9EEF7"/><TextBox x:Name="ParallelBox" Text="4"/></StackPanel><CheckBox x:Name="RoundRobinBox" Content="Round robin: all versions" VerticalAlignment="Center"/></WrapPanel>
      <WrapPanel><Button x:Name="RunBatchButton" Content="Run batch" Click="RunBatchClick"/><Button Content="Regression gate (500)" Click="GateClick"/><Button Content="Cancel" Click="CancelBatchClick"/><Button Content="Tune v3 weights…" Click="TuneClick"/></WrapPanel>
     </StackPanel>
     <StackPanel Grid.Row="1" Margin="0,10,0,16"><ProgressBar x:Name="BatchProgress" Height="8" Maximum="1"/><TextBlock x:Name="BatchStatus" Foreground="#A8C1DE" Margin="0,8,0,0" Text="Choose versions in Match setup, then run a batch."/></StackPanel>
     <Canvas x:Name="WinChart" Grid.Row="2" Height="130" Margin="0,0,0,12" Background="#102B54"/>
     <DataGrid x:Name="ResultsGrid" Grid.Row="3" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" HeadersVisibility="Column" Background="#F0F4FA" Foreground="#132033" BorderThickness="0" FontSize="13"/>
     <StackPanel Grid.Row="4" Margin="0,14,0,0"><TextBlock x:Name="HeadToHeadText" Foreground="#B4C8DF" TextWrapping="Wrap" Margin="0,0,0,10"/><WrapPanel><Button Content="Export JSON + CSV…" Click="ExportClick"/><Button Content="Replay longest" Click="ReplayLongestClick"/><Button Content="Replay biggest upset" Click="ReplayUpsetClick"/></WrapPanel></StackPanel>
    </Grid></TabItem>
    <TabItem Header="Neural training"><Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Train your next opponent" FontSize="26" FontWeight="Bold" Foreground="White"/><TextBlock Text="Learn from existing bots, then from game results. Keep the strongest validation checkpoint." Foreground="#BCD6F4" TextWrapping="Wrap" Margin="0,8,0,20"/>
      <WrapPanel><StackPanel Width="135" Margin="0,0,14,0"><TextBlock Text="Training games" Foreground="White"/><TextBox x:Name="TrainingGames" Text="2000"/></StackPanel><StackPanel Width="135" Margin="0,0,14,0"><TextBlock Text="Teacher games" Foreground="White"/><TextBox x:Name="WarmupGames" Text="200"/></StackPanel><StackPanel Width="135" Margin="0,0,14,0"><TextBlock Text="Check every" Foreground="White"/><TextBox x:Name="EvaluationEvery" Text="200"/></StackPanel><StackPanel Width="135" Margin="0,0,14,0"><TextBlock Text="Validation games" Foreground="White"/><TextBox x:Name="EvaluationGames" Text="100"/></StackPanel><StackPanel Width="135"><TextBlock Text="Learning rate" Foreground="White"/><TextBox x:Name="LearningRate" Text="0.015"/></StackPanel></WrapPanel>
      <StackPanel Width="230" HorizontalAlignment="Left"><TextBlock Text="Teacher" Foreground="White"/><ComboBox x:Name="TeacherBox" SelectedIndex="0"><ComboBoxItem Content="Weighted v3"/><ComboBoxItem Content="Heuristic v2"/></ComboBox></StackPanel><CheckBox x:Name="ContinueNetwork" Content="Continue loaded network (use its training seed to continue the same stream)"/>
      <TextBlock Text="Uses the player count and seed from Match setup. Training uses the agreed default rules. Validation always uses two players against Heuristic v2." Foreground="#BCD6F4" TextWrapping="Wrap" Margin="0,8,0,16"/>
      <WrapPanel><Button x:Name="TrainButton" Background="#FFD36B" Content="Train and save…" Click="TrainNeuralClick"/><Button Content="Load network…" Click="LoadBotConfigClick"/><Button Content="Stop training" Click="CancelBatchClick"/></WrapPanel>
     </StackPanel>
     <StackPanel Grid.Row="1" Margin="0,18"><ProgressBar x:Name="NeuralProgress" Height="10" Maximum="1"/><TextBlock x:Name="NeuralStatus" Text="Ready. Exported models work in Warzone and Arena." Foreground="#BCD6F4" TextWrapping="Wrap" Margin="0,12"/></StackPanel>
     <DataGrid x:Name="TrainingHistory" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" Background="#EDF5FF" Foreground="#142C51"/>
    </Grid></TabItem>
<TabItem Header="Match setup"><Grid Margin="0,18,0,0" MaxWidth="600" HorizontalAlignment="Left" Width="600">   <Border Background="#102B54" CornerRadius="14" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="MATCH SETUP" FontWeight="Bold" Foreground="#A8C1DE" Margin="0,0,0,14"/>
    <TextBlock Text="Players"/><ComboBox x:Name="PlayerCountBox" SelectedIndex="0" SelectionChanged="SetupChanged"><ComboBoxItem Content="2"/><ComboBoxItem Content="4"/></ComboBox>
    <TextBlock Text="Yellow" Foreground="#F4C541"/><ComboBox x:Name="Bot0" SelectionChanged="BotSelectionChanged"/>
    <Button Content="Load bot configuration…" Click="LoadBotConfigClick"/><TextBlock x:Name="CustomBotLabel" TextWrapping="Wrap" Foreground="#A8C1DE" Margin="0,0,0,8"/>
    <TextBlock x:Name="Seat1Label" Text="Red"/><ComboBox x:Name="Bot1"/>
    <StackPanel x:Name="ExtraSeats" Visibility="Collapsed"><TextBlock Text="Red" Foreground="#FF6575"/><ComboBox x:Name="Bot2"/><TextBlock Text="Green" Foreground="#44D59C"/><ComboBox x:Name="Bot3"/></StackPanel>
    <TextBlock Text="Seed"/><TextBox x:Name="SeedBox" Text="1"/>
    <TextBlock Text="Bot budget (ms)"/><TextBox x:Name="BudgetBox" Text="50"/>
    <Expander Header="Rule variations" Foreground="#E9EEF7" Margin="0,8"><StackPanel>
     <CheckBox x:Name="LaunchRule" Content="Six to leave base" IsChecked="True"/><CheckBox x:Name="SixRule" Content="Bonus on six" IsChecked="True"/><CheckBox x:Name="ThirdRule" Content="Discard third six" IsChecked="True"/><CheckBox x:Name="CaptureRule" Content="Bonus on capture" IsChecked="True"/><CheckBox x:Name="HomeRule" Content="Bonus on home" IsChecked="True"/><CheckBox x:Name="StarsRule" Content="Safe stars" IsChecked="True"/><CheckBox x:Name="StackRule" Content="Protected stacks" IsChecked="True"/><CheckBox x:Name="BlockingRule" Content="Legacy impassable stacks"/>
    </StackPanel></Expander>
    <Button Content="New match" Click="NewMatchClick" Margin="0,16,0,8"/><Button Content="Open replay…" Click="OpenReplayClick"/>
   </StackPanel></ScrollViewer></Border></Grid></TabItem>
   </TabControl>
  </Grid>
 </DockPanel>
</Window>
