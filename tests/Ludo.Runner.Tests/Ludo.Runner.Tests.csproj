<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/Ludo.Training/Ludo.Training.csproj" />
    <ProjectReference Include="../../src/Ludo.Presentation/Ludo.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ludo.Native\Ludo.Native.csproj" />
    <ProjectReference Include="../Ludo.HostFixture/Ludo.HostFixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyFixture" AfterTargets="Build">
    <ItemGroup><FixtureFiles Include="../Ludo.HostFixture/bin/$(Configuration)/net10.0/*" /></ItemGroup>
    <Copy SourceFiles="@(FixtureFiles)" DestinationFolder="$(OutDir)fixture" SkipUnchangedFiles="true" />
  </Target>

</Project>
